[flake8]
# Игнорировать ошибки, которые исправляет Black или которые слишком спорные:
# E203: Пробел перед двоеточием (конфликтует с Black)
# E501: Слишком длинная строка (обрабатывается Black line-length=88)
# W503: Разрыв строки перед бинарным оператором (конфликтует с Black)
# W504: Разрыв строки после бинарного оператора (стиль Black)
# F401: Импорт не используется, но если isort его оставляет (редко)
ignore = E203, E501, W503, W504
exclude = .venv,.git,__pycache__,docs,build,dist
max-line-length = 119